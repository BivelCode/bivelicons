{
  "$schema": "https://json.schemastore.org/package",
  "name": "bivelicons",
  "version": "0.0.0",
  "private": true,
  "description": "BivelIcons monorepo tooling and generators",
  "homepage": "https://github.com/BivelCode/bivelicons#readme",
  "bugs": {
    "url": "https://github.com/BivelCode/bivelicons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BivelCode/bivelicons.git"
  },
  "author": "Bivelcode",
  "license": "MIT",
  "scripts": {
    "assign-unicodes": "node scripts/assign-unicodes.js",
    "lint-svg": "node scripts/lint-svg.js",
    "optimize-svg": "node scripts/optimize-svg.js",
    "build-fonts": "node scripts/build-fonts.js",
    "build": "turbo run build-all",
    "ci": "turbo run build-all",
    "changeset": "changeset",
    "version": "changeset version",
    "release:version": "pnpm run version",
    "publish-package": "pnpm run build && cd packages/webfonts && npm publish --access public",
    "release:publish": "pnpm run publish-package",
    "release": "pnpm run release:version && pnpm run release:publish"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11",
      "onFail": "download"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "fantasticon": "^4.1.0",
    "fast-xml-parser": "^5.10.0",
    "handlebars": "^4.7.9",
    "svgo": "^4.0.2",
    "turbo": "^2.10.8"
  }
}