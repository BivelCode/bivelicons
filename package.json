{
  "$schema": "https://json.schemastore.org/package",
  "name": "bivel icons",
  "version": "0.0.0",
  "private": true,
  "description": "Bivelcode Icons monorepo tooling and generators",
  "packageManager": "pnpm@11.17.0",
  "homepage": "https://github.com/BivelCode/icons#readme",
  "bugs": {
    "url": "https://github.com/BivelCode/icons/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BivelCode/icons.git"
  },
  "author": "Bivelcode",
  "license": "MIT",
  "scripts": {
    "assign-unicodes": "node scripts/assign-unicodes.js",
    "lint-svg": "node scripts/lint-svg.js",
    "optimize-svg": "node scripts/optimize-svg.js",
    "build-fonts": "node --max-old-space-size=8192 scripts/build-fonts.js",
    "build": "turbo run build-all",
    "ci": "turbo run build-all"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "fantasticon": "^4.1.0",
    "fast-xml-parser": "^5.10.0",
    "handlebars": "^4.7.9",
    "svgo": "^4.0.2",
    "turbo": "^2.10.8"
  }
}