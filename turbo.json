{
    "ui": "tui",
    "tasks": {
        "assign-unicodes": {
            "outputs": [
                "configs/codepoints/**"
            ]
        },
        "lint-svg": {
            "dependsOn": [
                "assign-unicodes"
            ]
        },
        "optimize-svg": {
            "dependsOn": [
                "lint-svg"
            ],
            "outputs": [
                "packages/optimized/**"
            ]
        },
        "build-fonts": {
            "dependsOn": [
                "optimize-svg"
            ],
            "outputs": [
                "packages/webfonts/**"
            ]
        },
        "build-all": {
            "dependsOn": [
                "build-fonts"
            ]
        }
    }
}